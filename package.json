{
  "name": "reddigen-local",
  "version": "1.0.0",
  "private": true,
  "description": "ReddiGen — a local ML/NLP research build. Trains and serves five deep-learning models to discover high-intent buying conversations on Reddit.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "ml:setup": "python -m pip install -r ml/requirements.txt",
    "ml:serve": "python ml/server.py"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "next": "15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "prisma": "^6.5.0",
    "typescript": "^5.7.3"
  }
}
